# kubo-gateway — variables de entorno

PORT=8080
LOG_LEVEL=info

# URL interna del servicio de identidad y su documento JWKS
KUBO_IAM_URL=http://localhost:9081
KUBO_JWKS_URI=http://localhost:9081/api/v1/auth/.well-known/jwks.json
KUBO_JWT_ISSUER=kubo-iam
KUBO_JWT_AUDIENCE=kubo-api

# Microservicios de negocio
KUBO_CRM_URL=http://localhost:9082
KUBO_ERP_URL=http://localhost:9083
KUBO_ANALYTICS_URL=http://localhost:9084

# Limites de tasa (peticiones por minuto)
KUBO_RATE_LIMIT_PER_MINUTE=600
KUBO_AUTH_RATE_LIMIT_PER_MINUTE=40

REDIS_URL=redis://localhost:6380
